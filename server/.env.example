# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Server Configuration
PORT=3000
NODE_ENV=development

# OAuth Redirect URIs
REDIRECT_URI=http://localhost:3000/auth/callback

# Mobile App Callback (for deep linking)
MOBILE_CALLBACK_SCHEME=notemyminds://auth

# Security - CHANGE THESE IN PRODUCTION
ENCRYPTION_KEY=change-this-to-32-character-hex-string
SESSION_SECRET=change-this-to-random-secret

# CORS - Add your production URLs
ALLOWED_ORIGINS=http://localhost:3000

# API Base URL (used for redirects)
API_BASE_URL=http://localhost:3000
